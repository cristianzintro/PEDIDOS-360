[Unit]
Description=PEDIDOS-360 audit notification service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pedidos360
Group=pedidos360
WorkingDirectory=/opt/pedidos360/backend/audit-notification-service
EnvironmentFile=/etc/pedidos360/audit.env
Environment=SERVER_ADDRESS=127.0.0.1
ExecStart=/usr/bin/java -jar /opt/pedidos360/backend/audit-notification-service/target/audit-notification-service-1.0.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
