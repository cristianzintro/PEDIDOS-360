[Unit]
Description=PEDIDOS-360 BFF service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pedidos360
Group=pedidos360
WorkingDirectory=/opt/pedidos360/backend/bff-service
EnvironmentFile=/etc/pedidos360/bff.env
ExecStart=/usr/bin/java -jar /opt/pedidos360/backend/bff-service/target/bff-service-1.0.0-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
